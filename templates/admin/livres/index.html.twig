{% extends 'base.html.twig' %}

{% block title %}
	Administration des livres
	{{ parent() }}
{% endblock %}

{% block body %}
	<section class="container mt-4">
		<h1 class="text-center">Administration des livres</h1>
		<a href="{{ path('admin_livres_create') }}" class="btn btn-primary">Créer un livre</a>
		<div class="row gy-4 mt-4">
			{% for livre in livres %}
				<div class="col-md-4">
					{% include 'components/livres/_card.html.twig' with { isAdmin: true } %}
				</div>
			{% endfor %}
		</div>
	</section>
{% endblock %}
