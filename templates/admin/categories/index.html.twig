{% extends 'base.html.twig' %}

{% block title %}
	Administration des catégories
	{{ parent() }}
{% endblock %}

{% block body %}
	<section class="container mt-4">
		<h1 class="text-center">Administration des categories</h1>
		<a href="{{ path('admin_categories_create') }}" class="btn btn-primary">Créer une catégorie</a>
		<table class="table table-striped table-primary table-bordered mt-4">
			<thead>
				<tr>
					<th scope="col">ID</th>
					<th scope="col">Nom</th>
					<th scope="col">Status</th>
					<th scope="col">Date de création</th>
					<th scope="col">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for categorie in categories %}
					<tr scope="row">
						<td scope="col">{{ categorie.id }}</td>
						<td scope="col">{{ categorie.name }}</td>
						<td scope="col">
							<span class="badge text-bg-{{ categorie.enabled ? 'success' : 'danger' }}">
								{{ categorie.enabled ? 'Actif' : 'Inactif' }}
							</span>
						</td>
						<td scope="col">{{ categorie.createdAt|date('Y-m-d H:i') }}</td>
						<td scope="col">
							<div class="d-inline-flex align-items-center gap-2">
								<a href="{{ path('admin_categories_update', {id: categorie.id}) }}" class="btn btn-warning">
									<i class="bi bi-pencil-square"></i>
								</a>
								<form action="{{ path('admin_categories_delete', { id: categorie.id }) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?')">
									<input type="hidden" name="token_csrf" value="{{ csrf_token('delete' ~ categorie.id) }}">
									<button class="btn btn-danger">
										<i class="bi bi-trash"></i>
									</button>
								</form>
							</div>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</section>
{% endblock %}
