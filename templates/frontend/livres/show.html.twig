{% extends 'base.html.twig' %}

{% block title %}
	{{ livre.title }}
	{{ parent() }}
{% endblock %}

{% block body %}
	<section class="container mt-4">
		<h1 class="text-center">{{ livre.title }}</h1>
		<div class="row">
			<aside class="col-md-3">
				{% include 'frontend/livres/_informations.html.twig' %}
			</aside>
			<article class="col-md-9">
				{{ livre.content|nl2br }}
			</article>
		</div>
	</section>
{% endblock %}
