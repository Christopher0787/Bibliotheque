{% extends 'base.html.twig' %}

{% block title %}
	Page pour les Livres
	{{ parent() }}
{% endblock %}

{% block body %}
	<section class="container mt-4">
		<h1 class="text-center">Découvrez la liste des Livre</h1>

		<div class="row mt-2">
			<aside class="col-md-3">
				{% include 'components/livres/_filter.html.twig' %}
			</aside>
			<div class="col-md-9">
				<div class="d-flex justify-content-between align-item-center mt-3">
					{% include 'components/livres/_count.html.twig' %}
					{% include 'components/livres/_sortable.html.twig' %}
				</div>

				{% include 'components/livres/_list.html.twig' %}
				{% include 'components/livres/_pagination.html.twig' %}
			</div>
		</div>
	</section>
{% endblock %}
