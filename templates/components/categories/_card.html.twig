<div class="card">
	<h2 class="card-header">{{ categorie.name }}</h2>
	<div class="card-body">
		<p class="text-muted">ID:
			{{ categorie.id }}</p>
		<p class="card-text">{{ categorie.enabled }}</p>
		<p class="text-muted">Crée le
			{{ categorie.createdAt|date('Y-m-d H:i') }}</p>
		<div class="form-check form-switch">
			<input class="form-check-input" type="checkbox" id="visibility-article-{{ categorie.id }}" {{ categorie.enabled ? 'checked' }}/>
			<label class="form-check-label" for="visibility-article-{{ categorie.id }}">Actif</label>
		</div>
		<div class="d-flex justify-content-between align-items-center flex-wrap mt-2">
			<a href="{{ path('admin_categories_update', { id: categorie.id }) }}" class="btn btn-warning">Modifier</a>
			<form action="{{ path('admin_categories_delete', { id: categorie.id }) }}" method="POST" onsubmit="return confirm('Être-vous sur de vouloir supprimer cette categorie ?')">
				<input type="hidden" name="token_csrf" value="{{ csrf_token('delete' ~ categorie.id) }}">
				<button type="submit" class="btn btn-danger">Supprimer</button>
			</form>
		</div>
	</div>
</div>
