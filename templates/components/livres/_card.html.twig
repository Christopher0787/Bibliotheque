<div class="card">
	{% if livre.imageName %}
		<img src="{{ vich_uploader_asset(livre) }}" class="card-img" alt="Photo de {{ livre.title }}" loading="lazy">
	{% endif %}
	<div class="card-body">
		<h2 class="card-title">{{ livre.title }}</h2>
		{% if isAdmin|default(false) %}
			<em class="text-muted">ID:
				{{ livre.id }}</em>
		{% endif %}
		<p class="card-text">{{ livre.content|slice(0, 150) ~ '...' }}</p>
		<p class="text-muted">Crée le
			{{ livre.createdAt|date('Y-m-d H:i') }}</p>
		<p class="text-muted">Écrit par
			{{ livre.author.fullName }}</p>

		{% if livre.categorie %}
			<p class="badge text-bg-primary">{{ livre.categorie.name }}</p>
		{% endif %}

		<a href="{{ path('app_livre_show', { id: livre.id }) }}" class="mt-2 btn btn-primary d-block">En savoir plus</a>

		{% if isAdmin|default(false) %}
			<div class="form-check form-switch" data-controller="switchVisibility">
				<input data-id="{{ livre.id }}" class="form-check-input" type="checkbox" id="visibility-livre-{{ livre.id }}" {{ livre.enabled ? 'checked' }}/>
				<label class="form-check-label text-{{ livre.enabled ? 'success' : 'danger' }}" for="visibility-livre-{{ livre.id }}">{{ livre.enabled ? 'Actif' : 'Inactif' }}</label>
			</div>
			<div class="d-flex justify-content-between align-items-center flex-wrap mt-2">
				<a href="{{ path('admin_livres_update', { id: livre.id }) }}" class="btn btn-warning">Modifier</a>
				<form action="{{ path('admin_livres_delete', { id: livre.id }) }}" method="POST" onsubmit="return confirm('Être-vous sur de vouloir supprimer ce livre ?')">
					<input type="hidden" name="token_csrf" value="{{ csrf_token('delete' ~ livre.id) }}">
					<button type="submit" class="btn btn-danger">Supprimer</button>
				</form>
			</div>
		{% endif %}
	</div>
</div>
